# ===== 天勤账号配置（只存数据，所有逻辑在 server.py / tqsdk_data.py） =====
# 多账户：启动命令行按序号选择；name=显示名（随便起），user=账号，pwd=密码
ACCOUNTS = [
    {"name": "main", "user": "账户名称", "pwd": "密码"},
]

# CAPITAL = 20000    # 总资金基数（元），复盘系统"单笔风险≤2%"审计用，按真实情况填

# ===== LLM 接入（供应商中立：任何 OpenAI 兼容服务，三行缺一不可） =====
# 示例供应商：智谱 bigmodel.cn（有免费模型）/ DeepSeek / OpenAI / 月之暗面 / 本地 Ollama
LLM_API_URL = "https://open.bigmodel.cn/api/paas/v4/chat/completions"
LLM_MODEL = "glm-4.7-flash"
LLM_API_KEY = "你的key"
