# ===== Python 编译缓存 =====
__pycache__/
*.py[cod]
*.egg-info/

# ===== 本地便携依赖（83MB 第三方库，切勿入库）=====
# 本仓库自带的 pylibs/ 是为了不污染本机 Anaconda 环境而拷入的第三方库，
# 新机器/他人克隆后不要保留本目录，直接按 requirements.txt 用 pip 安装即可。
pylibs/

# ===== 虚拟环境 =====
.venv/
venv/
env/

# ===== 运行时生成的日志 =====
*.log

# ===== 调试与临时产物（每次改图/截图自检时生成的临时文件）=====
# 注意：加 / 前缀锚定到项目根目录，避免误伤子目录的 __init__.py 等正常文件
/_*.py
/_*.html
/_*.png
/_*.jpg
/_edge_*/
/shot_*.png
/dbg_*.py

# ===== IDE / 编辑器 =====
.vscode/
.idea/
.codebuddy/
*.swp

# ===== 本地凭证（切勿入库）=====
secret.py

# ===== 操作系统 =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== 安卓 APP 工程（mobile-app/）=====
# 源码入库（gradle 配置 + app/src + icon），构建产物和本机路径不入库
mobile-app/.gradle/
mobile-app/build/
mobile-app/app/build/
mobile-app/local.properties
mobile-app/.idea/
mobile-app/*.iml

# ===== Gitee 凭据（切勿入库）=====
data/gitee_conf.json

# ===== data/ 本机运行时状态（2026-10-15 定稿：自动重建、无跨机意义，不入云）=====
# 注意：这几个文件此前已被 git 跟踪，只加 ignore 不会立即生效于"已跟踪"状态，
# 它们仍会出现在 git status 里；彻底移出 GitHub 需要 git rm --cached（用户暂不执行）
# 形态监控事件流快照：每轮扫描重写，重启自动重建
data/pattern_snapshot.json
data/*.tmp
# 手续费缓存：启动自动联网刷新
data/fees_cache.json
# 统计页缓存：自动重建
data/.stats_cache.json
# 交易日历缓存：自动从新浪重建
data/trading_days_cache.json
# 本机选的天勤账户记忆
data/last_account.json
# 本机监控总开关状态
data/monitor_switch.json
# 本机反向中枢开关
data/pattern_flags.json
# 笔六开关：每台机器浏览器各自推送，git 同步会互相覆盖
data/pattern_bi_conf.json
# history 同步合并备份残留
data/history.json.bak

# APK 产物含设备配置，永不入库（2026-10-25）
*.apk
